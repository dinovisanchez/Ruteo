# Copia este archivo como backend/.env y completa los valores.
# El backend lo lee al arrancar (uvicorn se corre desde la carpeta backend).

# --- Metabase: de dónde salen las OTs ---
METABASE_URL=https://metabase.tu-empresa.com
# Opción 1 (recomendada): API key creada en Metabase > Admin > Autenticación > API keys
METABASE_API_KEY=
# Opción 2: usuario y contraseña de Metabase (si no hay API key)
METABASE_USERNAME=
METABASE_PASSWORD=
# Id de la pregunta con las OTs: el número en la URL /question/123-nombre
METABASE_CARD_ID=
# Opcional: si las columnas no se reconocen solas, indica campo -> columna de la pregunta
# METABASE_COLUMN_MAP={"codigo_bia": "OT", "or_operador": "Operador de red", "direccion": "Dirección", "gps": "Coordenadas"}

# --- Catálogo de bases y contratistas ---
# Opcional: URL CSV de la hoja "Data Contratista" publicada (Archivo > Compartir > Publicar en la web > CSV).
# Si está vacía se usa backend/data/contratistas.csv
CONTRATISTAS_CSV_URL=

# --- Geocodificación de OTs sin GPS (Nominatim / OpenStreetMap) ---
GEOCODING_ENABLED=true
GEOCODING_MAX_POR_CONSULTA=30

# --- Trazado de rutas por vías (OSRM) ---
# Por defecto el servidor público de OSRM. Déjalo vacío para dibujar líneas rectas.
OSRM_URL=https://router.project-osrm.org
# Respaldo si el principal no responde
OSRM_URL_RESPALDO=https://routing.openstreetmap.de/routed-car
# Pausa entre consultas: el servidor público pide 1 por segundo; con un OSRM propio puede ser 0
OSRM_PAUSA_SEGUNDOS=1
